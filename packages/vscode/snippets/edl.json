{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params})${3: -> ${4:returnType}} {",
      "\t${0:${5:// body}}",
      "}"
    ],
    "description": "Declare a function"
  },
  "Function with return type": {
    "prefix": "fnr",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:returnType} {",
      "\treturn ${0:value}",
      "}"
    ],
    "description": "Declare a function with a return type"
  },
  "Let binding": {
    "prefix": "let",
    "body": "let ${1:name}${2:: ${3:type}} = ${0:value}",
    "description": "Declare an immutable binding"
  },
  "Var binding": {
    "prefix": "var",
    "body": "var ${1:name}${2:: ${3:type}} = ${0:value}",
    "description": "Declare a mutable binding"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0:${2:// body}}",
      "}"
    ],
    "description": "If statement"
  },
  "If / Else statement": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "\t${0:${2:// body}}",
      "} else {",
      "\t${3}",
      "}"
    ],
    "description": "If / else statement"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0:${2:// body}}",
      "}"
    ],
    "description": "While loop"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${0:${3:// body}}",
      "}"
    ],
    "description": "For loop over a collection"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type}",
      "\t${0}",
      "}"
    ],
    "description": "Declare a struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Value},",
      "\t${0}",
      "}"
    ],
    "description": "Declare an enum"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:module}",
    "description": "Import a module"
  },
  "Return": {
    "prefix": "ret",
    "body": "return ${0:value}",
    "description": "Return from a function"
  },
  "Print": {
    "prefix": "print",
    "body": "print(${0:value})",
    "description": "Print a value"
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t${0}",
      "}"
    ],
    "description": "Declare the program entry point"
  }
}