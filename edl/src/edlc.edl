## `edlc` -- the EDL compiler.
##
## Command surface:
##
##   edlc check     <file.edl>          parse and type check, build nothing
##   edlc build     <file.edl>          compile to a native executable
##   edlc run       <file.edl>          build, then run
##   edlc emit-nim  <file.edl>          stop after emitting backend source
##   edlc emit-ast  <file.edl>          print the parsed syntax tree
##   edlc migrate   <file.edl>          translate bootstrap-dialect source to EDL, with a report
##   edlc init      [name]              scaffold a project: edl.toml + src/main.edl
##   edlc test      [paths...]          run the project's test programs (direct interpreter)
##   edlc version
##   edlc help
##
## check, build, run, emit-nim and emit-ast also work in **project mode**:
## without a file argument they compile the entry point of the nearest
## `edl.toml`, found by walking up from the current directory. The manifest
## format and the dependency design are in specs/packages.md.
##
## `fmt`, `doc`, `add` and `remove` are still part of the toolchain contract
## and report themselves as not implemented yet rather than pretending to work
## or silently doing nothing.
##
## Exit codes: 0 success, 1 compilation error, 2 usage error or unimplemented
## command, otherwise the exit code of the program that was run.
##
## Bootstrap dialect: see specs/decisions/ADR-0001.

import std/os
import std/strutils

import edl/diagnostics
import edl/driver
import edl/migrate/translate
import edl/project

const edlVersion = "0.1.0"

proc printUsage() =
  echo "edl " & edlVersion & " - the EDL compiler"
  echo ""
  echo "usage: edl <command> [options] <file.edl>"
  echo ""
  echo "commands"
  echo "  check     parse and type check a program, build nothing"
  echo "  build     compile a program to a native executable"
  echo "  run       build a program and run it"
  echo "  emit-nim  stop after emitting the bootstrap backend source"
  echo "  emit-ast  print the parsed syntax tree"
  echo "  migrate   translate a bootstrap-dialect source file to EDL and report what could not be"
  echo "  init      scaffold a new project (edl.toml and src/main.edl)"
  echo "  test      run the project's test programs with the direct interpreter"
  echo "  version   print the compiler version"
  echo "  help      print this message"
  echo "  fmt, doc, add, remove   not implemented yet"
  echo ""
  echo "project mode"
  echo "  without a file argument, check/build/run/emit-* compile the entry point of"
  echo "  the nearest edl.toml, walking up from the current directory"
  echo ""
  echo "options"
  echo "  -o <path>        output executable path"
  echo "  --out-dir <dir>  where generated files go (default: .edlout)"
  echo "  --bootstrap <path>  bootstrap compiler to use (default: bin/nim)"
  echo "  --print          print the generated source (emit-nim)"
  echo "  --dump-ir        print the EDL intermediate representation"
  echo "  --stdout         print the translation instead of writing a file (migrate)"

proc usageError(message: string): int =
  echo "edl: " & message
  echo "run 'edl help' for usage."
  result = 2

proc showDiagnostics(diags: Diagnostics) =
  if diags != nil and diags.items.len > 0:
    echo render(diags)

proc runCompileCommand(command: string, args: seq[string]): int =
  var opts = CompileOptions()
  var inputPath = ""
  var printSource = false
  var i = 1
  while i < args.len:
    let arg = args[i]
    case arg
    of "-o", "--output":
      if i + 1 >= args.len:
        return usageError("'" & arg & "' needs a path")
      inc i
      opts.outputPath = args[i]
    of "--out-dir":
      if i + 1 >= args.len:
        return usageError("'" & arg & "' needs a directory")
      inc i
      opts.outDir = args[i]
    of "--bootstrap":
      if i + 1 >= args.len:
        return usageError("'" & arg & "' needs a path")
      inc i
      opts.bootstrapExe = args[i]
    of "--print":
      printSource = true
    of "--dump-ir":
      opts.dumpIr = true
    of "--emit-only":
      opts.emitOnly = true
    else:
      if arg.len > 0 and arg[0] == '-':
        return usageError("unknown option '" & arg & "'")
      elif inputPath.len == 0:
        inputPath = arg
      else:
        return usageError("only one input file is supported")
    inc i

  if inputPath.len == 0:
    # project mode: the entry point of the nearest edl.toml
    let manifest = loadManifest(getCurrentDir())
    if not manifest.found:
      return usageError("'" & command & "' needs an input file (or an edl.toml project; run 'edl init' to create one)")
    if not manifest.isValid():
      echo "edl: invalid " & manifest.path & ":"
      echo renderErrors(manifest)
      return 1
    let entry = entryFullPath(manifest)
    if not fileExists(entry):
      echo "edl: the manifest's entry point '" & manifest.entry & "' does not exist"
      echo "     expected: " & entry
      return 1
    inputPath = entry

  opts.inputPath = inputPath
  if command == "check" or command == "emit-nim" or command == "emit-ast":
    opts.emitOnly = true
  if command == "emit-ast":
    opts.dumpAst = true
  if command == "run":
    opts.interpret = true

  let r = compileFile(opts)

  if command == "emit-ast":
    if r.astDump.len > 0:
      echo r.astDump
    showDiagnostics(r.diags)
    if r.ok: 0 else: 1

  elif command == "check":
    showDiagnostics(r.diags)
    if r.ok:
      echo inputPath & ": ok"
      0
    else:
      1

  elif command == "emit-nim":
    showDiagnostics(r.diags)
    if r.ok:
      if printSource:
        echo r.generatedSource
      else:
        echo r.generatedPath
      0
    else:
      1

  else:
    # run (interpreted) or build (native)
    if opts.dumpIr:
      echo r.irDump
    showDiagnostics(r.diags)
    if not r.ok:
      if r.toolOutput.len > 0:
        echo r.toolOutput
      1
    elif command == "run":
      r.exitCode
    else:
      echo r.exePath
      0

proc runInitCommand(args: seq[string]): int =
  ## `edl init` scaffolds a project: an edl.toml manifest and an entry point.
  ## It never overwrites: an existing project is a clean error, not a clobber.
  var name = ""
  var i = 1
  while i < args.len:
    let arg = args[i]
    if arg.len > 0 and arg[0] == '-':
      return usageError("unknown option '" & arg & "'")
    if name.len > 0:
      return usageError("only one project name is supported")
    name = arg
    inc i

  let cwd = getCurrentDir()
  var dir = cwd
  if name.len == 0:
    name = lastPathPart(cwd)
    if name.len == 0:
      return usageError("cannot derive a project name from this directory; pass one: edl init <name>")
  else:
    dir = cwd / name

  if not validProjectName(name):
    echo "edl: '" & name & "' is not a valid project name"
    echo "     use letters, digits, '-', '_' or '.'"
    return 2

  let manifestPath = dir / "edl.toml"
  let mainPath = dir / "src" / "main.edl"
  var conflicts = ""
  if fileExists(manifestPath):
    conflicts = manifestPath
  if fileExists(mainPath):
    if conflicts.len > 0:
      conflicts = conflicts & " and " & mainPath
    else:
      conflicts = mainPath
  if conflicts.len > 0:
    echo "edl: refusing to overwrite an existing project: " & conflicts
    return 1

  try:
    createDir(dir / "src")
  except OSError:
    echo "edl: cannot create '" & (dir / "src") & "'"
    return 1
  try:
    writeFile(manifestPath, scaffoldManifest(name))
    writeFile(mainPath, scaffoldMainSource(name))
  except IOError, OSError:
    echo "edl: cannot write the project files"
    return 1

  echo "edl init: created an EDL project in " & dir
  echo "  " & manifestPath
  echo "  " & mainPath
  if dir != cwd:
    echo ""
    echo "next:"
    echo "  cd " & name
    echo "  edl run"
  else:
    echo ""
    echo "next: edl run"
  result = 0

proc collectEdlFiles(path: string, files: var seq[string]) =
  ## Collects .edl files: a file goes in directly, a directory is walked
  ## recursively. The caller sorts for a deterministic order.
  if fileExists(path):
    if path.endsWith(".edl"):
      files.add(path)
    else:
      echo "edl test: skipping '" & path & "' (not a .edl file)"
  elif dirExists(path):
    for entry in walkDir(path):
      if entry.kind == pcDir or entry.kind == pcLinkToDir:
        collectEdlFiles(entry.path, files)
      elif entry.kind == pcFile and entry.path.endsWith(".edl"):
        files.add(entry.path)
  else:
    echo "edl test: no such file or directory: " & path

proc sortPaths(paths: var seq[string]) =
  ## Insertion sort: small inputs, deterministic order, no generics at the
  ## call site (ADR-0001).
  var i = 1
  while i < paths.len:
    let item = paths[i]
    var j = i - 1
    while j >= 0 and paths[j] > item:
      paths[j + 1] = paths[j]
      dec j
    paths[j + 1] = item
    inc i

proc runTestCommand(args: seq[string]): int =
  ## `edl test` runs the project's test programs with the direct interpreter:
  ## every test file is an EDL program with a main, and exit code 0 is a pass.
  ## No bootstrap compiler and no build artifacts are involved, so `edl test`
  ## works wherever `edl run` works.
  var targets: seq[string] = @[]
  var i = 1
  while i < args.len:
    let arg = args[i]
    if arg.len > 0 and arg[0] == '-':
      return usageError("unknown option '" & arg & "'")
    targets.add(arg)
    inc i

  let cwd = getCurrentDir()
  var root = cwd
  let manifest = loadManifest(cwd)
  if manifest.found:
    if not manifest.isValid():
      echo "edl: invalid " & manifest.path & ":"
      echo renderErrors(manifest)
      return 1
    root = manifest.rootDir

  if targets.len == 0:
    let testsDir = root / "tests"
    if dirExists(testsDir):
      targets.add(testsDir)

  var files: seq[string] = @[]
  for target in targets:
    collectEdlFiles(target, files)
  sortPaths(files)

  if files.len == 0:
    echo "edl test: no test files found"
    echo "     test files are .edl programs under the project's tests/ directory"
    return 0

  var passed = 0
  var failed = 0
  for file in files:
    var opts = CompileOptions()
    opts.inputPath = file
    opts.interpret = true
    let r = compileFile(opts)
    if r.ok and r.exitCode == 0:
      inc passed
    else:
      inc failed
      echo ""
      echo "FAIL " & file
      showDiagnostics(r.diags)
      if r.toolOutput.len > 0:
        echo r.toolOutput

  echo ""
  echo "edl test: " & $passed & " passed, " & $failed & " failed (" & $files.len & " total)"
  if failed > 0:
    result = 1
  else:
    result = 0

proc runMigrateCommand(args: seq[string]): int =
  ## `edl migrate` reads bootstrap-dialect source and writes EDL. The report is
  ## the point: it names
  ## every construct that has no EDL equivalent yet.
  var inputPath = ""
  var outputPath = ""
  var toStdout = false
  var i = 1
  while i < args.len:
    let arg = args[i]
    case arg
    of "-o", "--output":
      if i + 1 >= args.len:
        return usageError("'" & arg & "' needs a path")
      inc i
      outputPath = args[i]
    of "--stdout":
      toStdout = true
    else:
      if arg.len > 0 and arg[0] == '-':
        return usageError("unknown option '" & arg & "'")
      elif inputPath.len == 0:
        inputPath = arg
      else:
        return usageError("only one input file is supported")
    inc i

  if inputPath.len == 0:
    return usageError("'migrate' needs an input file")
  if not fileExists(inputPath):
    return usageError("no such file: " & inputPath)

  let migrated = migrateSource(readFile(inputPath), inputPath)

  if toStdout:
    echo migrated.edlSource
  else:
    if outputPath.len == 0:
      let parts = splitFile(inputPath)
      # Sources now carry the `.edl` extension themselves. A default output of
      # `<name>.edl` would clobber the input, so an already-`.edl` source keeps
      # its translation in a `.migrated.edl` file instead. Pass `-o` or
      # `--stdout` for full control.
      if parts.ext == ".edl":
        outputPath = parts.dir / parts.name & ".migrated.edl"
      else:
        outputPath = parts.dir / parts.name & ".edl"
    writeFile(outputPath, migrated.edlSource)
    echo "edl migrate: wrote " & outputPath
    echo ""

  echo renderMigrationReport(migrated)
  if countNotes(migrated.notes, mnBlocking) > 0:
    1
  else:
    0

proc main(): int =
  let args = commandLineParams()
  if args.len == 0:
    printUsage()
    return 0
  let command = args[0]
  case command
  of "help", "--help", "-h":
    printUsage()
    0
  of "version", "--version":
    echo "edl " & edlVersion
    0
  of "check", "build", "run", "emit-nim", "emit-ast":
    runCompileCommand(command, args)
  of "migrate":
    runMigrateCommand(args)
  of "init":
    runInitCommand(args)
  of "test":
    runTestCommand(args)
  of "fmt", "doc", "add", "remove":
    echo "edl: '" & command & "' is not implemented yet."
    echo "     The toolchain contract is defined in specs/compiler.md;"
    echo "     'add' and 'remove' are designed in specs/packages.md."
    2
  else:
    echo "edl: unknown command '" & command & "'"
    printUsage()
    2

quit(main())
