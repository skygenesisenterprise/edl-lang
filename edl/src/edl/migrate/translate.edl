## The migrator from the bootstrap dialect to EDL.
##
## Reads the *bootstrap dialect* (ADR-0001) and writes EDL. It is a
## structural translator, not a compiler: it reuses no bootstrap-semantics and,
## where EDL has no equivalent yet, it reports the construct instead of inventing
## a translation. Every reported construct leaves a `//` comment in the output, so
## the result always parses.
##
## Two kinds of report entry:
##
##   blocking  the construct has no EDL equivalent; the output does not compile
##             until a human resolves it (the note names the spec that tracks it)
##   advisory  the translation is faithful but lossy in a way worth reviewing
##             (dropped export markers, `result` rewritten to `return`, ...)
##
## What the migrator does *not* do, on purpose: it never guesses. A `seq[T]`
## becomes a report, not a renamed type. A pragma is dropped and logged, never
## silently obeyed. This is the difference between a migration and a rename.
##
## Usage from the CLI: `edl migrate <file.edl> [-o out.edl]`.

import ./bootstrap_lex

type
  MigNoteKind* = enum
    mnBlocking
    mnAdvisory

  MigNote* = object
    line*: int          ## 1-based line in the bootstrap source
    construct*: string  ## what was found
    action*: string     ## what the migrator did about it
    kind*: MigNoteKind

  MigrateResult* = object
    edlSource*: string
    notes*: seq[MigNote]
    sourcePath*: string

  MigLine = object
    lineNo*: int
    indent*: int
    toks*: seq[SourceTok]

  EnumValue = object
    value: string
    owner: string
    ambiguous: bool

  TailMode* = enum
    ## How a statement's position relates to the routine's end.
    tmNone   ## something follows: `result = x` must not become `return x`
    tmTail   ## last of the routine: `result = x` means `return x`
    tmValue  ## last of an `=`-expression body: the value IS the result

  Emitter = ref object
    buf: string
    notes: seq[MigNote]
    enumValues: seq[EnumValue]
    structs: seq[string]

# ---------------------------------------------------------------------------
# Emitting and reporting
# ---------------------------------------------------------------------------

proc write(e: Emitter, level: int, text: string) =
  for _ in 0 ..< level * 4:
    e.buf.add(' ')
  e.buf.add(text)
  e.buf.add('\n')

proc blocking(e: Emitter, line: int, construct, action: string) =
  e.notes.add(MigNote(line: line, construct: construct, action: action,
    kind: mnBlocking))

proc advisory(e: Emitter, line: int, construct, action: string) =
  e.notes.add(MigNote(line: line, construct: construct, action: action,
    kind: mnAdvisory))

proc blank(e: Emitter) =
  if e.buf.len > 0 and e.buf[^1] == '\n':
    e.buf.add('\n')

# ---------------------------------------------------------------------------
# Type names
# ---------------------------------------------------------------------------

proc mapTypeName*(name: string): string =
  ## Bootstrap primitives onto EDL primitives. `int`/`uint` are architecture
  ## sized in the bootstrap dialect, which is what `isize`/`usize` are in EDL.
  case name
  of "int": "isize"
  of "uint": "usize"
  of "int8": "i8"
  of "int16": "i16"
  of "int32": "i32"
  of "int64": "i64"
  of "uint8": "u8"
  of "uint16": "u16"
  of "uint32": "u32"
  of "uint64": "u64"
  of "float": "f64"
  of "float32": "f32"
  of "float64": "f64"
  else: name

const collectionHeads = ["seq", "openArray", "array", "Table", "HashSet",
                         "OrderedTable", "CountTable", "set", "cstring", "auto"]

proc isCollectionHead(name: string): bool =
  for head in collectionHeads:
    if head == name:
      return true
  result = false

# ---------------------------------------------------------------------------
# Tokens -> logical lines
# ---------------------------------------------------------------------------

proc stripPragmas(e: Emitter, toks: seq[SourceTok]): seq[SourceTok] =
  ## Removes `{. ... .}` runs. EDL has no pragmas: every one of them is logged,
  ## because `{.raises.}` or `{.inline.}` cannot be honoured later.
  result = @[]
  var i = 0
  while i < toks.len:
    if toks[i].kind == skPunct and toks[i].text == "{" and
       i + 1 < toks.len and toks[i + 1].kind == skPunct and
       toks[i + 1].text == ".":
      var j = i
      var closed = false
      while j < toks.len:
        if toks[j].kind == skPunct and toks[j].text == "}":
          closed = true
          break
        inc j
      advisory(e, toks[i].line, "a pragma",
        "pragmas do not exist in EDL and were dropped")
      if not closed:
        j = toks.len - 1
      i = j + 1
    else:
      result.add(toks[i])
      inc i

const routineKeywords = ["proc", "func", "iterator", "template", "macro",
                         "method", "converter"]

proc cannotEndStatement(t: SourceTok): bool =
  ## True for a token after which the bootstrap dialect lets the statement run
  ## onto the next
  ## source line (`a or\n b`, `f(x,\n y)`).
  case t.kind
  of skOperator:
    result = t.text != "="
  of skPunct:
    result = t.text == "," or t.text == "." or t.text == "(" or
             t.text == "[" or t.text == "{"
  of skKeyword:
    case t.text
    of "and", "or", "not", "in", "notin", "is", "isnot", "div", "mod",
       "shl", "shr", "xor": result = true
    else: result = false
  else:
    result = false

proc continuesStatement(line: seq[SourceTok], prev: SourceTok): bool =
  ## Whether the next source line continues the statement ending in `prev`.
  if prev.kind == skOperator and prev.text == "=":
    # `proc f() =` opens a body, so the next line is a new statement.
    # `let x =` / `result =` continue an expression onto the next line.
    result = line.len > 0
    for keyword in routineKeywords:
      if keyword == line[0].text:
        result = false
  else:
    result = cannotEndStatement(prev)

proc groupLines(toks: seq[SourceTok]): seq[MigLine] =
  ## Splits the token stream into logical lines. A token starts a new logical
  ## line only when no bracket is open and the previous token could end a
  ## statement, so `f(x,\n y)` and `a or\n b` each stay one statement.
  ## Indentation is the column of the first token.
  var depth = 0
  var previousLine = -1
  for tok in toks:
    if tok.kind == skEof:
      break
    let opens = tok.kind == skPunct and
      (tok.text == "(" or tok.text == "[" or tok.text == "{")
    let closes = tok.kind == skPunct and
      (tok.text == ")" or tok.text == "]" or tok.text == "}")
    # A logical line break needs a new source line, closed brackets, and a
    # previous token that could end a statement. Tracking the *previous token's*
    # line matters: when `)` closes mid-line, what follows still belongs to the
    # line that was open.
    if depth == 0 and tok.line != previousLine:
      var startsLine = true
      if result.len > 0 and result[^1].toks.len > 0 and
         continuesStatement(result[^1].toks, result[^1].toks[^1]):
        startsLine = false
      if startsLine:
        let indent = if tok.col > 1: tok.col - 1 else: 0
        result.add(MigLine(lineNo: tok.line, indent: indent, toks: @[]))
    if result.len > 0:
      result[^1].toks.add(tok)
    if opens:
      inc depth
    elif closes:
      dec depth
    previousLine = tok.line
  # strip statement separators, drop lines that held only separators
  var kept: seq[MigLine] = @[]
  for line in result:
    var toks = line.toks
    while toks.len > 0 and toks[^1].kind == skPunct and toks[^1].text == ";":
      toks.setLen(toks.len - 1)
    if toks.len > 0:
      kept.add(MigLine(lineNo: line.lineNo, indent: line.indent, toks: toks))
  result = kept

proc blockStop(lines: seq[MigLine], start, minIndent: int): int =
  ## Index one past the last line of the block that begins at `start`.
  var i = start
  while i < lines.len and lines[i].indent >= minIndent:
    inc i
  result = i

proc bodyOf(lines: seq[MigLine], header: int): tuple[first, stop: int] =
  ## The indented block belonging to the statement on line `header`.
  if header + 1 >= lines.len or lines[header + 1].indent <= lines[header].indent:
    return (header + 1, header + 1)
  result = (header + 1, blockStop(lines, header + 1, lines[header + 1].indent))

proc sliceToks(toks: seq[SourceTok], first, last: int): seq[SourceTok] =
  ## Inclusive both ends. Returns empty when the range is empty or reversed.
  if toks.len == 0 or first > last or first >= toks.len:
    return @[]
  let hi = if last >= toks.len: toks.len - 1 else: last
  if hi < first:
    return @[]
  result = toks[first .. hi]

proc chainExtent(lines: seq[MigLine], i, stop: int,
                 heads: seq[string]): int =
  ## Index one past the last branch of a chain: `if`/`elif`/`else`, or
  ## `case`/`of`/`else`. Used to tell whether the chain ends its range, which
  ## is what makes an assignment to `result` inside it a tail position.
  var current = i
  result = i + 1
  let indent = lines[i].indent
  while current < stop:
    let line = lines[current]
    if line.indent != indent:
      break
    var isBranch = false
    for head in heads:
      if head == line.toks[0].text:
        isBranch = true
    if not isBranch and current != i:
      break
    let (bodyFirst, bodyEnd) = bodyOf(lines, current)
    result = if bodyEnd > current: bodyEnd else: current + 1
    current = result

proc statementExtent(lines: seq[MigLine], i, stop: int): int =
  ## Index one past the whole statement that begins at `i`, nested blocks
  ## included. Used to tell whether a routine body is a single expression.
  if i >= stop or lines[i].toks.len == 0:
    return i + 1
  var head = ""
  if lines[i].toks[0].kind == skKeyword:
    head = lines[i].toks[0].text
  case head
  of "if":
    result = chainExtent(lines, i, stop, @["if", "elif", "else"])
  of "case":
    result = chainExtent(lines, i, stop, @["case", "of", "else"])
  of "while", "for", "block", "when", "try", "type", "proc", "func",
     "iterator", "template", "macro", "converter", "method":
    let (_, bodyEnd) = bodyOf(lines, i)
    result = if bodyEnd > i: bodyEnd else: i + 1
  else:
    result = i + 1

# ---------------------------------------------------------------------------
# Rendering tokens back to EDL text
# ---------------------------------------------------------------------------

proc isValueToken(t: SourceTok): bool =
  case t.kind
  of skIdent, skNumber, skString, skChar: true
  of skPunct: t.text == ")" or t.text == "]" or t.text == "}"
  else: false

proc noSpaceAfter(t: SourceTok): bool =
  if t.kind == skPunct:
    result = t.text == "(" or t.text == "[" or t.text == "."
  elif t.kind == skOperator:
    # `@[]` and `@[...]` read better without a space
    result = t.text == "@"
  else:
    result = false

proc noSpaceBefore(t: SourceTok): bool =
  if t.kind == skPunct:
    case t.text
    of ")", "]", ",", ".", "(", "[", ":", ";": result = true
    else: result = false
  else:
    result = false

proc needsSpace(prev, cur: SourceTok): bool =
  if noSpaceAfter(prev):
    return false
  if noSpaceBefore(cur):
    return false
  result = true

const unimplementedBuiltins = ["inc", "dec", "new", "default", "high",
  "low", "ord", "chr", "len", "add", "incl", "excl", "newSeq", "insert",
  "delete", "pop", "contains", "count", "find", "startsWith", "endsWith",
  "split", "join", "strip", "toLower", "toUpper"]

proc renderTokensImpl(e: Emitter, toks: seq[SourceTok], asType: bool,
                      qualify: bool): string =
  ## Turns a token run back into EDL surface syntax, mapping what maps and
  ## reporting what does not.
  var texts: seq[string] = @[]
  var source: seq[SourceTok] = @[]
  var i = 0
  while i < toks.len:
    let tok = toks[i]
    var text = tok.text
    var keep = true
    case tok.kind
    of skIdent:
      if asType:
        text = mapTypeName(tok.text)
      else:
        if tok.text == "result":
          blocking(e, tok.line, "the `result` variable",
            "rewritten to `return` where the statement allowed it")
        for builtin in unimplementedBuiltins:
          if builtin == tok.text:
            blocking(e, tok.line, "the builtin `" & tok.text & "`",
              "no EDL equivalent yet (specs/types.md)")
        if qualify:
          # The bootstrap dialect writes enum values unqualified; EDL requires `Type.Value`.
          if not (i > 0 and toks[i - 1].text == ".") and
             not (i + 1 < toks.len and toks[i + 1].text == "("):
            for enumValue in e.enumValues:
              if enumValue.value == tok.text:
                if enumValue.ambiguous:
                  blocking(e, tok.line, "the enum value `" & tok.text & "`",
                    "more than one enum declares this name; qualify it by hand")
                else:
                  text = enumValue.owner & "." & enumValue.value
                break
          # `Point(x: 1)` constructs an object in the bootstrap dialect. EDL has no
          # literal for
          # that yet, and a call to a type is not a thing.
          if i + 1 < toks.len and toks[i + 1].text == "(":
            for declared in e.structs:
              if declared == tok.text:
                blocking(e, tok.line, "the construction `" & tok.text & "(...)`",
                  "EDL has no struct literal syntax yet (specs/types.md)")
                break
    of skKeyword:
      case text
      of "div": text = "/"
      of "mod": text = "%"
      of "and", "or", "not": discard
      of "nil":
        blocking(e, tok.line, "`nil`",
          "EDL has no null; use Option<T> (specs/errors.md)")
      else:
        blocking(e, tok.line, "the keyword `" & text & "`",
          "no EDL equivalent yet")
    of skOperator:
      case text
      of "&":
        if i + 1 < toks.len and toks[i + 1].kind == skString and
           (i == 0 or not isValueToken(toks[i - 1])):
          blocking(e, tok.line, "string interpolation",
            "use `+` concatenation instead")
        text = "+"
      of "..", "..<":
        blocking(e, tok.line, "a range",
          "ranges are only supported as `for` bounds (specs/syntax.md)")
      of "$":
        blocking(e, tok.line, "`$`", "stringification is not implemented yet")
      of "@":
        blocking(e, tok.line, "a sequence literal",
          "collections are not implemented yet (specs/types.md)")
      of "->":
        blocking(e, tok.line, "`->`", "function types are not supported yet")
      of "!", "?", "~", "|", "^", "\\":
        blocking(e, tok.line, "the operator `" & text & "`",
          "no EDL equivalent yet")
      else:
        discard
    of skBad:
      blocking(e, tok.line, "an unrecognised character",
        "the migrator only understands the bootstrap dialect")
    of skNumber:
      # EDL has no literal suffixes; the type comes from the binding.
      let quote = tok.text.find('\'')
      if quote >= 0:
        advisory(e, tok.line, "the literal suffix on `" & tok.text & "`",
          "dropped; in EDL the type comes from context")
        text = tok.text[0 ..< quote]
    of skString, skChar, skPunct:
      discard
    of skEof:
      keep = false
    if keep:
      texts.add(text)
      source.add(tok)
    inc i

  result = ""
  for idx in 0 ..< texts.len:
    if idx > 0 and needsSpace(source[idx - 1], source[idx]):
      result.add(' ')
    result.add(texts[idx])

proc renderTokens(e: Emitter, toks: seq[SourceTok], asType: bool): string =
  ## Renders an expression or a type reference.
  result = renderTokensImpl(e, toks, asType, true)

proc renderDeclaredName(e: Emitter, toks: seq[SourceTok]): string =
  ## Renders a name being *introduced* -- a field, a parameter, a local, an
  ## enum value. Such a name must never be qualified as a reference to itself.
  result = renderTokensImpl(e, toks, false, false)

proc renderType(e: Emitter, toks: seq[SourceTok], line: int, what: string): string =
  if toks.len == 0:
    blocking(e, line, "a missing type annotation", what & " must be typed in EDL")
    return "unknown"
  if toks[0].kind == skIdent and isCollectionHead(toks[0].text):
    blocking(e, line, "the type `" & renderTokens(e, toks, true) & "`",
      "collections are not implemented yet (specs/types.md)")
    return "unknown"
  if toks[0].kind == skKeyword and (toks[0].text == "ref" or toks[0].text == "ptr"):
    blocking(e, line, "the type `" & renderTokens(e, toks, true) & "`",
      "references are not part of the EDL memory model yet (specs/memory.md)")
    return renderType(e, sliceToks(toks, 1, toks.len - 1), line, what)
  if toks[0].kind == skKeyword and toks[0].text == "tuple":
    blocking(e, line, "a tuple type",
      "tuples are not implemented yet (specs/types.md)")
    return "unknown"
  result = renderTokens(e, toks, true)

# ---------------------------------------------------------------------------
# Small structural helpers
# ---------------------------------------------------------------------------

proc findTop(toks: seq[SourceTok], text: string): int =
  ## Index of the first occurrence of `text` outside any bracket.
  var depth = 0
  for idx in 0 ..< toks.len:
    let tok = toks[idx]
    if tok.kind == skPunct:
      case tok.text
      of "(", "[", "{": inc depth
      of ")", "]", "}": dec depth
      else: discard
    if depth == 0 and tok.text == text and
       not (tok.kind == skPunct and
            (tok.text == "(" or tok.text == "[" or tok.text == "{")):
      return idx
  result = -1

proc findFirst(toks: seq[SourceTok], text: string): int =
  ## Index of the first token with this text, bracket or not.
  for idx in 0 ..< toks.len:
    if toks[idx].text == text:
      return idx
  result = -1

proc firstColonTop(toks: seq[SourceTok]): int =
  ## The colon that separates a header from its body. It is the first colon
  ## outside brackets: `if f(a): return` and `if a[0]: x` both work.
  var depth = 0
  for idx in 0 ..< toks.len:
    let tok = toks[idx]
    if tok.kind == skPunct:
      case tok.text
      of "(", "[", "{": inc depth
      of ")", "]", "}": dec depth
      of ":":
        if depth == 0:
          return idx
      else: discard
  result = -1

proc matchingParen(toks: seq[SourceTok], open: int): int =
  var depth = 0
  for idx in open ..< toks.len:
    if toks[idx].kind == skPunct:
      if toks[idx].text == "(":
        inc depth
      elif toks[idx].text == ")":
        dec depth
        if depth == 0:
          return idx
  result = -1

proc splitTop(toks: seq[SourceTok], separator: string): seq[seq[SourceTok]] =
  ## Splits on `separator` outside any bracket.
  result = @[]
  var start = 0
  var depth = 0
  var idx = 0
  while idx < toks.len:
    let tok = toks[idx]
    if tok.kind == skPunct:
      case tok.text
      of "(", "[", "{": inc depth
      of ")", "]", "}": dec depth
      else: discard
    if depth == 0 and tok.text == separator:
      result.add(sliceToks(toks, start, idx - 1))
      start = idx + 1
    inc idx
  result.add(sliceToks(toks, start, toks.len - 1))

proc dropExportMarker(toks: seq[SourceTok]): seq[SourceTok] =
  ## `name*` is the bootstrap dialect's export marker; EDL has no visibility
  ## modifiers yet.
  if toks.len >= 2 and toks[1].kind == skOperator and toks[1].text == "*":
    result = @[toks[0]]
    for idx in 2 ..< toks.len:
      result.add(toks[idx])
  else:
    result = toks

proc isExportMarked(toks: seq[SourceTok]): bool =
  result = toks.len >= 2 and toks[1].kind == skOperator and toks[1].text == "*"

proc renderRaw(toks: seq[SourceTok]): string =
  ## Joins token texts with no mapping and no reporting. Used for text that is
  ## already accounted for, such as a commented-out statement.
  result = ""
  for idx in 0 ..< toks.len:
    if idx > 0 and needsSpace(toks[idx - 1], toks[idx]):
      result.add(' ')
    result.add(toks[idx].text)

# ---------------------------------------------------------------------------
# Enum value collection
# ---------------------------------------------------------------------------

proc gatherEnumValueNames(lines: seq[MigLine], header: int,
                          kind: seq[SourceTok]): seq[string] =
  ## The value names of one `enum` item, from its header and its block.
  result = @[]
  var valueToks: seq[SourceTok] = sliceToks(kind, 1, kind.len - 1)
  let (bodyFirst, bodyEnd) = bodyOf(lines, header)
  for idx in bodyFirst ..< bodyEnd:
    valueToks.add(SourceTok(kind: skPunct, text: ",", line: lines[idx].lineNo,
      col: 1))
    for tok in lines[idx].toks:
      valueToks.add(tok)
  for value in splitTop(valueToks, ","):
    if value.len == 0:
      continue
    result.add(value[0].text)

proc registerTypeAt(e: Emitter, lines: seq[MigLine], header: int) =
  var toks = dropExportMarker(lines[header].toks)
  let equals = findTop(toks, "=")
  if equals < 1:
    return
  let typeName = toks[0].text
  let kind = sliceToks(toks, equals + 1, toks.len - 1)
  if kind.len == 0:
    return
  if kind[0].text == "object":
    e.structs.add(typeName)
    return
  if kind[0].text == "ref" and kind.len > 1 and kind[1].text == "object":
    e.structs.add(typeName)
    return
  if kind[0].text != "enum":
    return
  for value in gatherEnumValueNames(lines, header, kind):
    var ambiguous = false
    for existing in e.enumValues:
      if existing.value == value and existing.owner != typeName:
        ambiguous = true
    e.enumValues.add(EnumValue(value: value, owner: typeName,
      ambiguous: ambiguous))
  advisory(e, lines[header].lineNo, "the enum `" & typeName & "`",
    "its values are written `" & typeName &
    ".Value` when referenced; the bootstrap dialect's unqualified form is not valid EDL")

proc collectTypeNames(e: Emitter, lines: seq[MigLine]) =
  ## Pre-pass over the type sections. Without it a bare `Red` cannot be told
  ## from a variable of the same name -- and the bootstrap dialect's unqualified
  ## enum values would
  ## stay unqualified, which EDL rejects -- nor can `Point(...)` be recognised
  ## as an object construction rather than a call.
  var i = 0
  while i < lines.len:
    let line = lines[i]
    if line.toks.len > 0 and line.toks[0].text == "type":
      if line.toks.len > 1:
        registerTypeAt(e, lines, i)
        let (_, bodyEnd) = bodyOf(lines, i)
        i = if bodyEnd > i: bodyEnd else: i + 1
      else:
        var current = i + 1
        while current < lines.len and lines[current].indent > line.indent:
          registerTypeAt(e, lines, current)
          let (_, bodyEnd) = bodyOf(lines, current)
          current = if bodyEnd > current: bodyEnd else: current + 1
        i = current
      continue
    inc i

# ---------------------------------------------------------------------------
# Forward declarations
# ---------------------------------------------------------------------------

proc translateRange(e: Emitter, lines: seq[MigLine], start, stop, level: int,
                    tail: TailMode)
proc translateInlineStatement(e: Emitter, toks: seq[SourceTok], level: int,
                              tail: TailMode)

# ---------------------------------------------------------------------------
# Parameters and routines
# ---------------------------------------------------------------------------

const modifierKeywords = ["var", "sink", "lent", "typed", "in", "out"]

proc renderParamSurfaces(e: Emitter, toks: seq[SourceTok], line: int): seq[string] =
  ## Renders the interior of a parameter list. The bootstrap dialect groups
  ## parameters with `;`
  ## and names within a group with `,`, so `a, b: int` is two parameters of one
  ## type while `p: Point; v: bool` is two groups.
  result = @[]
  for group in splitTop(toks, ";"):
    if group.len == 0:
      continue
    var part = group
    var isModifier = false
    if part[0].kind == skKeyword:
      for modifier in modifierKeywords:
        if modifier == part[0].text:
          isModifier = true
    if isModifier:
      blocking(e, part[0].line, "a `" & part[0].text & "` parameter",
        "not part of the EDL parameter model yet (specs/memory.md)")
      part = sliceToks(part, 1, part.len - 1)
    let equals = findTop(part, "=")
    if equals >= 0:
      blocking(e, part[equals].line, "a default parameter value",
        "EDL has no default arguments (ADR-0001); the default was dropped")
      part = sliceToks(part, 0, equals - 1)
    if part.len == 0:
      continue
    let colon = findTop(part, ":")
    if colon < 0:
      for name in splitTop(part, ","):
        if name.len == 0:
          continue
        blocking(e, name[0].line, "a parameter with no type",
          "EDL requires parameter types")
        result.add(renderDeclaredName(e, name) & ": unknown")
      continue
    let typeText = renderType(e, sliceToks(part, colon + 1, part.len - 1),
      part[colon].line, "this parameter")
    for name in splitTop(sliceToks(part, 0, colon - 1), ","):
      if name.len == 0:
        continue
      var paramName = renderDeclaredName(e, name)
      if paramName.len == 0:
        paramName = "_"
      result.add(paramName & ": " & typeText)

proc translateRoutine(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                      keyword: string): int =
  let line = lines[i]
  let toks = line.toks
  # An operator definition, `proc `+`*(a, b: T): T`. The bootstrap dialect
  # quotes such names in
  # backticks; EDL has no operator overloading, so it is named, not guessed at.
  if toks.len > 2 and toks[1].kind == skPunct and toks[1].text == "`":
    var closing = -1
    for idx in 2 ..< toks.len:
      if toks[idx].kind == skPunct and toks[idx].text == "`":
        closing = idx
        break
    var operatorName = "?"
    if closing > 0:
      operatorName = renderRaw(sliceToks(toks, 2, closing - 1))
    blocking(e, line.lineNo, "the operator definition `" & operatorName & "`",
      "operator overloading is not part of EDL (specs/language.md); " &
      "the routine was commented out")
    let (_, bodyEnd) = bodyOf(lines, i)
    e.write(level, "// " & renderRaw(toks))
    return if bodyEnd > i: bodyEnd else: i + 1
  var name = ""
  var nameIdx = -1
  var idx = 1
  while idx < toks.len:
    if toks[idx].kind == skIdent:
      name = toks[idx].text
      nameIdx = idx
      break
    if toks[idx].kind == skPunct and toks[idx].text == "(":
      break
    inc idx
  if nameIdx < 0:
    blocking(e, line.lineNo, "a `" & keyword & "` with no name",
      "the declaration was dropped")
    let (_, bodyEnd) = bodyOf(lines, i)
    return bodyEnd

  let isExport = nameIdx + 1 < toks.len and isExportMarked(
    sliceToks(toks, nameIdx, nameIdx + 1))
  if isExport:
    advisory(e, line.lineNo, "the export marker `*` on " & keyword & " `" &
      name & "`", "dropped; EDL has no visibility modifiers yet")

  let open = findFirst(sliceToks(toks, nameIdx + 1, toks.len - 1), "(")
  if open < 0:
    blocking(e, line.lineNo, "a `" & keyword & "` with no parameter list",
      "the declaration was dropped")
    let (_, bodyEnd) = bodyOf(lines, i)
    return bodyEnd
  let openIdx = nameIdx + 1 + open
  let closeIdx = matchingParen(toks, openIdx)
  if closeIdx < 0:
    blocking(e, line.lineNo, "an unclosed parameter list",
      "the declaration was dropped")
    let (_, bodyEnd) = bodyOf(lines, i)
    return bodyEnd

  let params = renderParamSurfaces(e,
    sliceToks(toks, openIdx + 1, closeIdx - 1), line.lineNo)

  # `proc f(): int = case ... of A: 1` -- the body is one expression and its
  # value is the result. A void routine has no such body.

  # Return type: everything between `)` and `=`, minus pragmas (already gone).
  var returnType = ""
  let equals = findTop(sliceToks(toks, closeIdx + 1, toks.len - 1), "=")
  var headerEnd = toks.len - 1
  if equals >= 0:
    headerEnd = closeIdx + 1 + equals
  let afterParams = sliceToks(toks, closeIdx + 1, headerEnd - 1)
  if afterParams.len > 0:
    var typeStart = 0
    if afterParams[0].text == ":":
      typeStart = 1
    returnType = renderType(e,
      sliceToks(afterParams, typeStart, afterParams.len - 1), line.lineNo,
      "the return type")

  var header = "fn " & name & "("
  for p in 0 ..< params.len:
    if p > 0:
      header.add(", ")
    header.add(params[p])
  header.add(")")
  if returnType.len > 0 and returnType != "unknown":
    header.add(" -> " & returnType)
  e.write(level, header & " {")

  # Body: either indented lines, or a single expression after `=`.
  let (bodyFirst, bodyEnd) = bodyOf(lines, i)
  if equals >= 0:
    let inlineBody = sliceToks(toks, headerEnd + 1, toks.len - 1)
    if inlineBody.len > 0 and bodyFirst >= bodyEnd:
      # `proc f(): bool = a == b` on one line.
      e.write(level + 1, "return " & renderTokens(e, inlineBody, false))
    elif inlineBody.len > 0:
      blocking(e, line.lineNo, "a `" & keyword &
        "` with both an inline and an indented body",
        "the inline part was dropped")
  if bodyFirst < bodyEnd:
    var bodyTail = tmTail
    if returnType.len > 0 and returnType != "unknown" and returnType != "void" and
       statementExtent(lines, bodyFirst, bodyEnd) >= bodyEnd:
      bodyTail = tmValue
    translateRange(e, lines, bodyFirst, bodyEnd, level + 1, bodyTail)
  e.write(level, "}")
  result = if bodyEnd > i: bodyEnd else: i + 1

# ---------------------------------------------------------------------------
# Statements
# ---------------------------------------------------------------------------

proc conditionOf(e: Emitter, toks: seq[SourceTok], what: string): string =
  ## Everything between the keyword and the colon that opens the body.
  let colon = firstColonTop(toks)
  if colon >= 0:
    result = renderTokens(e, sliceToks(toks, 1, colon - 1), false)
  else:
    result = renderTokens(e, sliceToks(toks, 1, toks.len - 1), false)
    blocking(e, toks[0].line, "the `" & what &
      "` header has no `:`", "the translated block may not be equivalent")

proc inlineBodyOf(toks: seq[SourceTok]): seq[SourceTok] =
  ## The statement sharing a line with its header: `if x: return`.
  let colon = firstColonTop(toks)
  if colon >= 0 and colon + 1 < toks.len:
    result = sliceToks(toks, colon + 1, toks.len - 1)
  else:
    result = @[]

proc splitIfSegments(toks: seq[SourceTok]): seq[seq[SourceTok]] =
  ## One segment per branch. `if n < 0: 0 else: n` is two branches on one line,
  ## which is how the bootstrap dialect writes an `if` expression.
  result = @[]
  var depth = 0
  var start = 0
  var seenColon = false
  var idx = 0
  while idx < toks.len:
    let tok = toks[idx]
    if tok.kind == skPunct:
      case tok.text
      of "(", "[", "{": inc depth
      of ")", "]", "}": dec depth
      of ":":
        if depth == 0:
          seenColon = true
      else: discard
    if depth == 0 and seenColon and idx > start and tok.kind == skKeyword and
       (tok.text == "else" or tok.text == "elif"):
      result.add(sliceToks(toks, start, idx - 1))
      start = idx
      seenColon = false
    inc idx
  result.add(sliceToks(toks, start, toks.len - 1))

proc translateIf(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                 tail: TailMode): int =
  ## `if`/`elif`/`else` is already the shape EDL uses; the work is the braces,
  ## the trailing colons, and branches that share a line.
  var current = i
  var first = true
  let chainIndent = lines[i].indent
  var childTail = tmNone
  if tail != tmNone and chainExtent(lines, i, stop, @["if", "elif", "else"]) >= stop:
    childTail = tail
  while current < stop:
    let line = lines[current]
    if line.indent != chainIndent:
      break
    let head = line.toks[0].text
    if current != i and head != "elif" and head != "else":
      break
    if head != "if" and head != "elif" and head != "else":
      break
    let segments = splitIfSegments(line.toks)
    for s in 0 ..< segments.len:
      let segment = segments[s]
      let segmentHead = segment[0].text
      if segmentHead == "if" or segmentHead == "elif":
        let cond = conditionOf(e, segment, segmentHead)
        if first:
          e.write(level, "if " & cond & " {")
        else:
          e.write(level, "} else if " & cond & " {")
        first = false
      else:
        e.write(level, "} else {")
      let inlineBody = inlineBodyOf(segment)
      if inlineBody.len > 0:
        translateInlineStatement(e, inlineBody, level + 1, childTail)
      if s == segments.len - 1:
        # only the last segment of a line can own an indented block
        let (bodyFirst, bodyEnd) = bodyOf(lines, current)
        if bodyFirst < bodyEnd:
          translateRange(e, lines, bodyFirst, bodyEnd, level + 1, childTail)
        current = if bodyEnd > current: bodyEnd else: current + 1
  e.write(level, "}")
  result = current

proc translateWhile(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                    tail: TailMode): int =
  ## A loop body is never a tail position: it may run again, or not at all.
  discard tail
  let line = lines[i]
  e.write(level, "while " & conditionOf(e, line.toks, "while") & " {")
  let inlineBody = inlineBodyOf(line.toks)
  if inlineBody.len > 0:
    translateInlineStatement(e, inlineBody, level + 1, tmNone)
  let (bodyFirst, bodyEnd) = bodyOf(lines, i)
  if bodyFirst < bodyEnd:
    translateRange(e, lines, bodyFirst, bodyEnd, level + 1, tmNone)
  e.write(level, "}")
  result = bodyEnd

proc translateBlockStatement(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                             tail: TailMode): int =
  let line = lines[i]
  var toks = sliceToks(line.toks, 1, line.toks.len - 1)
  if toks.len > 0 and toks[0].kind == skIdent:
    blocking(e, line.lineNo, "a labelled `block`",
      "labelled blocks are not part of EDL; the label was dropped")
    toks = sliceToks(toks, 1, toks.len - 1)
  e.write(level, "{")
  let (bodyFirst, bodyEnd) = bodyOf(lines, i)
  let extentEnd = if bodyEnd > i: bodyEnd else: i + 1
  var childTail = tmNone
  if tail != tmNone and extentEnd >= stop:
    childTail = tail
  if bodyFirst < bodyEnd:
    translateRange(e, lines, bodyFirst, bodyEnd, level + 1, childTail)
  e.write(level, "}")
  result = extentEnd

proc translateFor(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                  tail: TailMode): int =
  ## EDL has no range iterator yet, so `for i in a ..< b` is desugared to a
  ## `while` loop. The desugaring is only faithful if the body does not
  ## `continue` (which would skip the increment) -- that case is reported.
  discard tail
  let line = lines[i]
  let toks = line.toks
  let inIdx = findTop(sliceToks(toks, 1, toks.len - 1), "in")
  if inIdx < 0:
    blocking(e, line.lineNo, "a `for` loop with no `in`",
      "the loop was dropped")
    let (_, bodyEnd) = bodyOf(lines, i)
    return bodyEnd
  let inAbs = 1 + inIdx
  let varName = renderDeclaredName(e, sliceToks(toks, 1, inAbs - 1))
  var iterEnd = toks.len - 1
  let forColon = firstColonTop(toks)
  if forColon >= 0:
    iterEnd = forColon - 1
  let iterToks = sliceToks(toks, inAbs + 1, iterEnd)
  let (bodyFirst, bodyEnd) = bodyOf(lines, i)

  var rangeAt = -1
  for idx in 0 ..< iterToks.len:
    if iterToks[idx].kind == skOperator and
       (iterToks[idx].text == ".." or iterToks[idx].text == "..<"):
      rangeAt = idx
      break
  if rangeAt < 0:
    blocking(e, line.lineNo, "`for` over a collection",
      "iteration over collections is not implemented yet; the loop was dropped")
    e.write(level, "// for " & varName & " in " & renderRaw(iterToks) & " { ... }")
    let inlineBody = inlineBodyOf(line.toks)
    if inlineBody.len > 0:
      translateInlineStatement(e, inlineBody, level, tmNone)
    return bodyEnd

  let exclusive = iterToks[rangeAt].text == "..<"
  let lo = renderTokens(e, sliceToks(iterToks, 0, rangeAt - 1), false)
  let hi = renderTokens(e, sliceToks(iterToks, rangeAt + 1, iterToks.len - 1), false)
  var boundIsSimple = true
  let hiToks = sliceToks(iterToks, rangeAt + 1, iterToks.len - 1)
  if hiToks.len != 1 or
     (hiToks[0].kind != skIdent and hiToks[0].kind != skNumber):
    boundIsSimple = false
  if not boundIsSimple:
    advisory(e, line.lineNo, "a `for` bound that is not a simple name",
      "the bound is evaluated once by the translated `while` loop; check for side effects")
  # The loop variable must not leak into the surrounding scope, so the
  # desugaring is wrapped in a block -- which is what a `for` scope is.
  e.write(level, "{")
  e.write(level + 1, "var " & varName & " = " & lo)
  e.write(level + 1, "while " & varName & (if exclusive: " < " else: " <= ") &
    hi & " {")
  let inlineBody = inlineBodyOf(line.toks)
  if inlineBody.len > 0:
    translateInlineStatement(e, inlineBody, level + 2, tmNone)
  if bodyFirst < bodyEnd:
    translateRange(e, lines, bodyFirst, bodyEnd, level + 2, tmNone)
    for idx in bodyFirst ..< bodyEnd:
      if lines[idx].toks.len > 0 and lines[idx].toks[0].text == "continue":
        blocking(e, lines[idx].lineNo, "`continue` inside a translated `for`",
          "the increment would be skipped; restructure the loop")
  e.write(level + 2, varName & " = " & varName & " + 1")
  e.write(level + 1, "}")
  e.write(level, "}")
  result = bodyEnd

proc translateCase(e: Emitter, lines: seq[MigLine], i, stop, level: int,
                   tail: TailMode): int =
  ## `case` becomes an `if`/`else if` chain. EDL has no `case` yet.
  var childTail = tmNone
  if tail != tmNone and chainExtent(lines, i, stop, @["case", "of", "else"]) >= stop:
    childTail = tail
  let line = lines[i]
  var subjectEnd = line.toks.len - 1
  if firstColonTop(line.toks) >= 0:
    subjectEnd = firstColonTop(line.toks) - 1
  let subject = renderTokens(e, sliceToks(line.toks, 1, subjectEnd), false)
  advisory(e, line.lineNo, "a `case` statement",
    "translated to an `if` chain")
  var current = i + 1
  var first = true
  while current < stop and lines[current].indent == line.indent:
    let branch = lines[current]
    let head = branch.toks[0].text
    if head == "of":
      var values: seq[string] = @[]
      var valueEnd = branch.toks.len - 1
      if firstColonTop(branch.toks) >= 0:
        valueEnd = firstColonTop(branch.toks) - 1
      let valueToks = sliceToks(branch.toks, 1, valueEnd)
      for alternative in splitTop(valueToks, ","):
        if alternative.len == 0:
          continue
        var hasRange = false
        for tok in alternative:
          if tok.kind == skOperator and
             (tok.text == ".." or tok.text == "..<"):
            hasRange = true
        if hasRange:
          blocking(e, branch.lineNo, "an `of` range",
            "range branches of `case` are not translated")
          continue
        values.add(subject & " == " & renderTokens(e, alternative, false))
      var cond = ""
      for v in 0 ..< values.len:
        if v > 0:
          cond.add(" or ")
        cond.add(values[v])
      if cond.len == 0:
        cond = "false"
      if first:
        e.write(level, "if " & cond & " {")
      else:
        e.write(level, "} else if " & cond & " {")
      first = false
    elif head == "else":
      e.write(level, "} else {")
    else:
      break
    let inlineBody = inlineBodyOf(branch.toks)
    if inlineBody.len > 0:
      translateInlineStatement(e, inlineBody, level + 1, childTail)
    let (bodyFirst, bodyEnd) = bodyOf(lines, current)
    if bodyFirst < bodyEnd:
      translateRange(e, lines, bodyFirst, bodyEnd, level + 1, childTail)
    current = if bodyEnd > current: bodyEnd else: current + 1
  if first:
    e.write(level, "// case " & subject & ": no branches were translated")
    return current
  e.write(level, "}")
  result = current

proc translateBinding(e: Emitter, lines: seq[MigLine], i, level: int,
                      keyword: string): int =
  let line = lines[i]
  let toks = line.toks
  let rest = sliceToks(toks, 1, toks.len - 1)
  let equals = findTop(rest, "=")
  var lhs = rest
  var rhs: seq[SourceTok] = @[]
  if equals >= 0:
    lhs = sliceToks(rest, 0, equals - 1)
    rhs = sliceToks(rest, equals + 1, rest.len - 1)

  if lhs.len == 0:
    blocking(e, line.lineNo, "a `" & keyword & "` with no name",
      "the declaration was dropped")
    return i + 1

  if lhs[0].kind == skPunct and lhs[0].text == "(":
    blocking(e, line.lineNo, "a tuple destructuring " & keyword,
      "tuple unpacking is not supported yet (specs/types.md)")
    e.write(level, "// " & renderRaw(line.toks))
    return i + 1

  let colon = findTop(lhs, ":")
  var name = ""
  var typeText = ""
  if colon >= 0:
    name = renderDeclaredName(e, sliceToks(lhs, 0, colon - 1))
    typeText = renderType(e, sliceToks(lhs, colon + 1, lhs.len - 1),
      line.lineNo, "this variable")
  else:
    name = renderDeclaredName(e, lhs)

  if rhs.len == 0:
    blocking(e, line.lineNo, "a `" & keyword & "` with no initialiser",
      "EDL requires every binding to be initialised")
    e.write(level, "// " & keyword & " " & name)
    return i + 1

  var text = keyword & " " & name
  if typeText.len > 0 and typeText != "unknown":
    text.add(": " & typeText)
  text.add(" = " & renderTokens(e, rhs, false))
  e.write(level, text)
  result = i + 1

proc translateExpressionStatement(e: Emitter, lines: seq[MigLine], i,
                                  level: int, tail: TailMode): int =
  let line = lines[i]
  let toks = line.toks
  let head = toks[0]
  # `result = expr` is the bootstrap dialect's return value, but only a *tail*
  # assignment is a
  # `return`: anywhere else the routine carries on afterwards, and rewriting it
  # would silently change the program.
  if head.kind == skIdent and head.text == "result" and toks.len >= 2 and
     toks[1].kind == skOperator and toks[1].text == "=":
    let rhs = sliceToks(toks, 2, toks.len - 1)
    if tail != tmNone:
      advisory(e, line.lineNo, "an assignment to `result`",
        "rewritten as `return`, which is what it means in tail position")
      e.write(level, "return " & renderTokens(e, rhs, false))
    else:
      blocking(e, line.lineNo, "an assignment to `result`",
        "EDL has no result variable and this is not the routine's last " &
        "statement; restructure the routine so it ends in `return`")
      e.write(level, "result = " & renderTokens(e, rhs, false))
    return i + 1
  if head.kind == skIdent and (head.text == "inc" or head.text == "dec"):
    let target = renderTokens(e, sliceToks(toks, 1, toks.len - 1), false)
    if head.text == "inc":
      e.write(level, target & " = " & target & " + 1")
    else:
      e.write(level, target & " = " & target & " - 1")
    advisory(e, line.lineNo, "`" & head.text & "`",
      "rewritten as an explicit assignment")
    return i + 1
  if head.kind == skIdent and head.text == "echo":
    let args = splitTop(sliceToks(toks, 1, toks.len - 1), ",")
    if args.len > 1:
      blocking(e, line.lineNo, "`echo` with several arguments",
        "EDL's `print` takes one argument; only the first was kept")
    if args.len > 0 and args[0].len > 0:
      e.write(level, "print(" & renderTokens(e, args[0], false) & ")")
      advisory(e, line.lineNo, "`echo`", "rewritten as `print`")
    return i + 1
  let rendered = renderTokens(e, toks, false)
  if rendered.len > 0:
    if tail == tmValue:
      # the routine's body is an expression, so this is its value
      e.write(level, "return " & rendered)
    else:
      e.write(level, rendered)
  result = i + 1

proc translateInlineStatement(e: Emitter, toks: seq[SourceTok], level: int,
                              tail: TailMode) =
  ## A statement sharing its line with a header (`if x: return y`). Only the
  ## single-statement forms exist in the bootstrap dialect, so those are all
  ## that is handled.
  if toks.len == 0:
    return
  let head = toks[0]
  if head.kind == skKeyword:
    case head.text
    of "return":
      let value = sliceToks(toks, 1, toks.len - 1)
      if value.len > 0:
        e.write(level, "return " & renderTokens(e, value, false))
      else:
        e.write(level, "return")
    of "discard":
      let value = sliceToks(toks, 1, toks.len - 1)
      if value.len > 0:
        e.write(level, renderTokens(e, value, false))
    of "break", "continue":
      e.write(level, head.text)
    else:
      blocking(e, head.line, "an inline `" & head.text & "`",
        "only single statements can share a line; restructure this one")
  else:
    var lines: seq[MigLine] = @[MigLine(lineNo: head.line, indent: 0,
      toks: toks)]
    discard translateExpressionStatement(e, lines, 0, level, tail)

proc translateRange(e: Emitter, lines: seq[MigLine], start, stop, level: int,
                    tail: TailMode) =
  ## `tail` says how this range ends with respect to the routine, which is what
  ## decides whether `result = x` may become `return x`.
  var i = start
  while i < stop:
    let line = lines[i]
    if line.toks.len == 0:
      inc i
      continue
    let head = line.toks[0]
    # a single-line statement is in tail position when it is the range's last
    let lastInRange = if i + 1 >= stop: tail else: tmNone
    if head.kind == skKeyword:
      case head.text
      of "if":
        i = translateIf(e, lines, i, stop, level, tail)
      of "while":
        i = translateWhile(e, lines, i, stop, level, tail)
      of "for":
        i = translateFor(e, lines, i, stop, level, tail)
      of "case":
        i = translateCase(e, lines, i, stop, level, tail)
      of "block":
        i = translateBlockStatement(e, lines, i, stop, level, tail)
      of "let", "var":
        i = translateBinding(e, lines, i, level, head.text)
      of "return":
        let value = sliceToks(line.toks, 1, line.toks.len - 1)
        if value.len > 0:
          e.write(level, "return " & renderTokens(e, value, false))
        else:
          e.write(level, "return")
        inc i
      of "discard":
        let value = sliceToks(line.toks, 1, line.toks.len - 1)
        if value.len > 0:
          e.write(level, renderTokens(e, value, false))
        inc i
      of "break", "continue":
        e.write(level, head.text)
        inc i
      of "proc", "func":
        i = translateRoutine(e, lines, i, stop, level, head.text)
      of "raise", "try", "except", "finally", "defer", "yield", "iterator",
         "template", "macro", "converter", "method", "concept", "when",
         "include", "mixin", "bind", "using", "asm", "static", "export",
         "from", "import", "const":
        blocking(e, line.lineNo, "`" & head.text & "`",
          "no EDL equivalent yet; the statement was commented out")
        e.write(level, "// " & renderRaw(line.toks))
        let (_, bodyEnd) = bodyOf(lines, i)
        i = if bodyEnd > i: bodyEnd else: i + 1
      else:
        blocking(e, line.lineNo, "the keyword `" & head.text & "`",
          "the statement was commented out")
        e.write(level, "// " & renderRaw(line.toks))
        inc i
    else:
      i = translateExpressionStatement(e, lines, i, level, lastInRange)

# ---------------------------------------------------------------------------
# Top level
# ---------------------------------------------------------------------------

proc translateTypeItem(e: Emitter, lines: seq[MigLine], i, level: int): int =
  let line = lines[i]
  var toks = dropExportMarker(line.toks)
  if isExportMarked(line.toks):
    advisory(e, line.lineNo, "an exported type",
      "the `*` marker was dropped; EDL has no visibility modifiers yet")
  let equals = findTop(toks, "=")
  if equals < 1:
    blocking(e, line.lineNo, "a type item with no `=`",
      "the item was commented out")
    e.write(level, "// " & renderRaw(toks))
    let (_, bodyEnd) = bodyOf(lines, i)
    return if bodyEnd > i: bodyEnd else: i + 1
  let name = toks[0].text
  let kind = sliceToks(toks, equals + 1, toks.len - 1)
  let (bodyFirst, bodyEnd) = bodyOf(lines, i)

  if kind.len > 0 and kind[0].text == "object":
    e.write(level, "struct " & name & " {")
    for idx in bodyFirst ..< bodyEnd:
      let field = lines[idx]
      var ftoks = field.toks
      if isExportMarked(ftoks):
        ftoks = dropExportMarker(ftoks)
      let fcolon = findTop(ftoks, ":")
      if fcolon < 0:
        blocking(e, field.lineNo, "a field with no type",
          "the field was commented out")
        e.write(level + 1, "// " & renderRaw(ftoks))
        continue
      let fname = renderDeclaredName(e, sliceToks(ftoks, 0, fcolon - 1))
      let ftype = renderType(e, sliceToks(ftoks, fcolon + 1, ftoks.len - 1),
        field.lineNo, "this field")
      if ftype == "unknown":
        e.write(level + 1, "// " & fname & ": <unsupported type>")
      else:
        e.write(level + 1, fname & ": " & ftype)
    e.write(level, "}")
  elif kind.len > 0 and kind[0].text == "ref" and kind.len > 1 and
       kind[1].text == "object":
    blocking(e, line.lineNo, "`ref object`",
      "references are not part of the EDL memory model yet (specs/memory.md); " &
      "emitted as a value struct")
    e.write(level, "struct " & name & " {")
    for idx in bodyFirst ..< bodyEnd:
      let field = lines[idx]
      var ftoks = field.toks
      if isExportMarked(ftoks):
        ftoks = dropExportMarker(ftoks)
      let fcolon = findTop(ftoks, ":")
      if fcolon < 0:
        continue
      let fname = renderDeclaredName(e, sliceToks(ftoks, 0, fcolon - 1))
      let ftype = renderType(e, sliceToks(ftoks, fcolon + 1, ftoks.len - 1),
        field.lineNo, "this field")
      if ftype == "unknown":
        e.write(level + 1, "// " & fname & ": <unsupported type>")
      else:
        e.write(level + 1, fname & ": " & ftype)
    e.write(level, "}")
  elif kind.len > 0 and kind[0].text == "enum":
    e.write(level, "enum " & name & " {")
    var valueToks: seq[SourceTok] = sliceToks(kind, 1, kind.len - 1)
    for idx in bodyFirst ..< bodyEnd:
      valueToks.add(SourceTok(kind: skPunct, text: ",", line: lines[idx].lineNo,
        col: 1))
      for tok in lines[idx].toks:
        valueToks.add(tok)
    var sawExplicit = false
    for value in splitTop(valueToks, ","):
      if value.len == 0:
        continue
      let vequals = findTop(value, "=")
      if vequals >= 0:
        sawExplicit = true
      e.write(level + 1, renderDeclaredName(e, value) & ",")
    if sawExplicit:
      advisory(e, line.lineNo, "an enum with explicit values",
        "EDL requires enum values to be strictly increasing; verify the order")
    e.write(level, "}")
  else:
    blocking(e, line.lineNo, "the type `" & name & " = " &
      renderTokens(e, kind, false) & "`",
      "type aliases and distinct types are not supported yet (specs/types.md); " &
      "the item was commented out")
    e.write(level, "// type " & name & " = " & renderRaw(kind))
  result = if bodyEnd > i: bodyEnd else: i + 1

proc translateTypeSection(e: Emitter, lines: seq[MigLine], i, level: int): int =
  let line = lines[i]
  if line.toks.len > 1:
    return translateTypeItem(e, lines, i, level)
  var current = i + 1
  while current < lines.len and lines[current].indent > line.indent:
    current = translateTypeItem(e, lines, current, level)
  result = current

proc translateImports(e: Emitter, lines: seq[MigLine], i: int): int =
  let line = lines[i]
  blocking(e, line.lineNo, "`" & renderRaw(sliceToks(line.toks, 0, 0)) & "`",
    "the EDL module system is specified but not implemented yet (specs/modules.md)")
  e.write(0, "// " & renderRaw(line.toks))
  result = i + 1

proc translateTopLevel(e: Emitter, lines: seq[MigLine]) =
  var i = 0
  while i < lines.len:
    let line = lines[i]
    let head = line.toks[0]
    if head.kind == skKeyword:
      case head.text
      of "import", "from":
        i = translateImports(e, lines, i)
      of "type":
        i = translateTypeSection(e, lines, i, 0)
      of "proc", "func":
        blank(e)
        i = translateRoutine(e, lines, i, lines.len, 0, head.text)
      of "let", "var":
        blocking(e, line.lineNo, "a module-level `" & head.text & "`",
          "EDL has no module-level statements yet (specs/modules.md); " &
          "move it into a function")
        e.write(0, "// " & renderRaw(line.toks))
        i = i + 1
      of "const", "iterator", "template", "macro", "method", "converter",
         "when", "include", "export", "using":
        blocking(e, line.lineNo, "`" & head.text & "`",
          "no EDL equivalent yet; the declaration was commented out")
        e.write(0, "// " & renderRaw(line.toks))
        let (_, bodyEnd) = bodyOf(lines, i)
        i = if bodyEnd > i: bodyEnd else: i + 1
      else:
        blocking(e, line.lineNo, "the keyword `" & head.text & "`",
          "the statement was commented out")
        e.write(0, "// " & renderRaw(line.toks))
        i = i + 1
    else:
      blocking(e, line.lineNo, "a top-level statement",
        "every EDL statement must live inside a function (specs/language.md)")
      e.write(0, "// " & renderRaw(line.toks))
      i = i + 1

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

proc migrateSource*(source: string, sourcePath: string): MigrateResult =
  ## Translates bootstrap-dialect source to EDL. Pure: no file access.
  let e = Emitter(buf: "", notes: @[])
  let raw = tokenizeBootstrap(source)
  let toks = stripPragmas(e, raw)
  let lines = groupLines(toks)
  collectTypeNames(e, lines)
  e.buf.add("// Generated by `edl migrate` from " & sourcePath & ".\n")
  e.buf.add("// Review the migration report: every construct it lists was NOT translated.\n")
  e.buf.add("// See specs/migration.md for what the migrator covers.\n\n")
  translateTopLevel(e, lines)
  result = MigrateResult(edlSource: e.buf, notes: e.notes, sourcePath: sourcePath)

proc countNotes*(notes: seq[MigNote], kind: MigNoteKind): int =
  for note in notes:
    if note.kind == kind:
      inc result

proc renderMigrationReport*(r: MigrateResult): string =
  ## A report a human can act on, ordered by source line.
  let blockingCount = countNotes(r.notes, mnBlocking)
  let advisoryCount = countNotes(r.notes, mnAdvisory)
  result = r.sourcePath & ": " & $blockingCount & " construct(s) not translated, " &
    $advisoryCount & " note(s)\n"
  type OrderedNote = tuple[line: int, handled: bool, text: string, kind: MigNoteKind]
  var ordered: seq[OrderedNote] = @[]
  for note in r.notes:
    let label = if note.kind == mnBlocking: "not translated" else: "note"
    ordered.add((note.line, note.kind == mnBlocking,
      "line " & $note.line & ": " & note.construct & " -- " & note.action,
      note.kind))
  # a plain insertion sort: reports are small and line order reads best
  var idx = 1
  while idx < ordered.len:
    let item = ordered[idx]
    var j = idx - 1
    while j >= 0 and (ordered[j].line > item.line or
                      (ordered[j].line == item.line and
                       not ordered[j].handled and item.handled)):
      ordered[j + 1] = ordered[j]
      dec j
    ordered[j + 1] = item
    inc idx
  if blockingCount > 0:
    result.add("not translated (the output does not compile until these are resolved)\n")
    for entry in ordered:
      if entry.kind == mnBlocking:
        result.add("  " & entry.text & "\n")
  if advisoryCount > 0:
    result.add("notes (translated, but check the result)\n")
    for entry in ordered:
      if entry.kind == mnAdvisory:
        result.add("  " & entry.text & "\n")
