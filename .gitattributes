# ------------------------------------------------------------------

# Git attributes

# ------------------------------------------------------------------

# Changelog additions should merge cleanly when possible.

/changelog.md merge=union

# ------------------------------------------------------------------

# Line endings

# ------------------------------------------------------------------

# Shell and bootstrap configuration files must remain LF.

*.sh text eol=lf
/config/build_config.txt text eol=lf

# ------------------------------------------------------------------

# GitHub Linguist — EDL

# ------------------------------------------------------------------

# EDL is the project's primary source language.

#

# Keep every .edl file detectable, including sources under:

# - edl/

# - compiler/

# - tools/

# - tests/

# - packages/

# - future directories

#

# This override is useful once EDL is known by GitHub Linguist.

*.edl linguist-language=EDL

# ------------------------------------------------------------------

# GitHub Linguist — Nim bootstrap substrate

# ------------------------------------------------------------------

# The repository still contains a large Nim-derived bootstrap substrate.

# These files are transitional implementation infrastructure and should

# not dominate the repository language statistics.

# Nim source files.

*.nim linguist-vendored
*.nims linguist-vendored
*.nimf linguist-vendored

# Nim package / project metadata.

*.nimble linguist-vendored
*.nimble.* linguist-vendored

# Nim configuration files.

*.nim.cfg linguist-vendored

# ------------------------------------------------------------------

# Explicit bootstrap files

# ------------------------------------------------------------------

# These files are part of the legacy bootstrap/build infrastructure.

/nim.nimble linguist-vendored
/koch.nim linguist-vendored
/koch.nim.cfg linguist-vendored

# Legacy bootstrap build scripts.

/build_all.sh linguist-vendored
/build_all.bat linguist-vendored
/azure-pipelines.yml linguist-vendored

# ------------------------------------------------------------------

# Bootstrap-generated / machine-generated content

# ------------------------------------------------------------------

# Only use these overrides if these directories are actually tracked

# and contain generated artifacts.

/nimcache/** linguist-generated
/.nimble/** linguist-generated

# ------------------------------------------------------------------

# Important policy

# ------------------------------------------------------------------

# Do NOT mark compiler/, tools/, lsp/, formatter/, analyzer/,

# docgen/, tests/, or other project directories as vendored.

#

# Those directories may contain EDL code during the migration and

# must remain first-class project sources.

#

# The migration is file-based:

#

# *.edl  -> EDL

# *.nim  -> transitional Nim bootstrap

#

# rather than directory-based.
