# Avoids changelog conflicts by assuming additions-only, which is by far the common case.

# In the rare case where branch b1 rebases against branch b2 and both branches

# modified the same changelog entry, you'll end up with that changelog entry

# duplicated, which is easily identifiable and fixable.

/changelog.md merge=union

# ------------------------------------------------------------------

# Line endings

# ------------------------------------------------------------------

# Shell scripts and bootstrap configuration files must stay LF on every

# platform, including Windows/WSL environments.

/*.sh text eol=lf
*.sh text eol=lf
/config/build_config.txt text eol=lf

# ------------------------------------------------------------------

# GitHub Linguist — EDL

# ------------------------------------------------------------------

# Explicitly classify every .edl source file as EDL.

#

# This is a repository-level Linguist override. It prevents .edl files

# from being classified as another language when automatic detection is

# unavailable or ambiguous.

#

# EDL must still be registered in GitHub Linguist's language database for

# GitHub to fully recognize EDL as a language.

*.edl linguist-language=EDL

# ------------------------------------------------------------------

# GitHub Linguist — Bootstrap substrate

# ------------------------------------------------------------------

# The compiler is currently being migrated from a Nim-derived bootstrap

# substrate to native EDL.

#

# Nim sources are transitional implementation details and should not make

# the repository appear to be primarily a Nim project in GitHub's language

# statistics.

#

# These attributes affect GitHub Linguist classification only. They do not

# affect Git, the compiler, CI, builds, or the actual source files.

# ------------------------------------------------------------------

# Bootstrap files

# ------------------------------------------------------------------

/koch.nim linguist-vendored
/koch.nim.cfg linguist-vendored
/nim.nimble linguist-vendored
/build_all.sh linguist-vendored
/build_all.bat linguist-vendored
/azure-pipelines.yml linguist-vendored

# ------------------------------------------------------------------

# Nim bootstrap sources

# ------------------------------------------------------------------

# Any remaining Nim-family source files are transitional bootstrap code.

/*.nim linguist-vendored
*.nim linguist-vendored
*.nims linguist-vendored
*.nimble linguist-vendored
*.nimble.* linguist-vendored
*.nimf linguist-vendored
*.nim.cfg linguist-vendored

# ------------------------------------------------------------------

# Bootstrap metadata / generated files

# ------------------------------------------------------------------

# Nim compiler/cache artifacts should not contribute to language statistics.

nimcache/** linguist-generated
.nimble/** linguist-generated

# ------------------------------------------------------------------

# Future EDL migration

# ------------------------------------------------------------------

# Do not mark .edl files as vendored.

#

# EDL sources remain first-class project sources throughout the migration,

# including EDL files located under compiler/, tools/, tests/, etc.

#

# The explicit linguist-language=EDL rule above therefore remains the

# authoritative repository-level classification for EDL sources.
