# ============================================================================

# EDL — Git attributes

# ============================================================================

#

# This file defines repository-level Git attributes used by GitHub Linguist,

# line-ending normalization, and generated/bootstrap source classification.

#

# Main principle:

# - Every *.edl file is first-class EDL source code.

# - EDL source must remain visible in GitHub language statistics.

# - Transitional bootstrap sources and generated artifacts must not distort

# the project's language statistics.

#

# ============================================================================

# ============================================================================

# Changelog

# ============================================================================

/changelog.md merge=union

# ============================================================================

# Line endings

# ============================================================================

# Shell scripts must always use LF.

*.sh text eol=lf

# Build configuration must always use LF.

/config/build_config.txt text eol=lf

# ============================================================================

# GitHub Linguist — EDL

# ============================================================================

#

# Every .edl file in the repository is EDL source code.

#

# This intentionally applies recursively to the entire repository:

#

# compiler/**/*.edl

# edl/**/*.edl

# tests/**/*.edl

# examples/**/*.edl

# tools/**/*.edl

# *.edl

#

# Do NOT mark EDL directories as vendored or generated.

#

# ============================================================================

*.edl linguist-language=EDL

# ============================================================================

# GitHub Linguist — Transitional bootstrap

# ============================================================================

#

# The repository is progressively migrating away from the original bootstrap

# implementation. These files are implementation infrastructure rather than

# EDL source code and therefore should not dominate the language statistics.

#

# These attributes affect Linguist classification only.

# They do not remove files from Git and do not affect compilation.

# ============================================================================

# ----------------------------------------------------------------------------

# Nim source

# ----------------------------------------------------------------------------

#

# Any remaining Nim source is transitional bootstrap code.

#

*.nim linguist-vendored
*.nims linguist-vendored
*.nimf linguist-vendored
*.nimble linguist-vendored
*.nimble.* linguist-vendored
*.nim.cfg linguist-vendored

# ----------------------------------------------------------------------------

# Bootstrap build files

# ----------------------------------------------------------------------------

/koch.nim linguist-vendored
/koch.nim.cfg linguist-vendored

/build_all.sh linguist-vendored
/build_all.bat linguist-vendored

/nim.nimble linguist-vendored

/azure-pipelines.yml linguist-vendored

# ============================================================================

# Generated / cache files

# ============================================================================

#

# Generated compiler artifacts and dependency caches must not contribute to

# GitHub language statistics.

# ============================================================================

nimcache/** linguist-generated
.nimble/** linguist-generated

# Generic build output directories.

/build/** linguist-generated
/dist/** linguist-generated
/out/** linguist-generated
/target/** linguist-generated

# ============================================================================

# Generated documentation / website artifacts

# ============================================================================

#

# Only use these rules for files that are actually generated.

# Hand-written EDL documentation should remain detectable normally.

# ============================================================================

# Common generated documentation output.

/site/_build/** linguist-generated
/docs/_build/** linguist-generated

# ============================================================================

# Vendored third-party sources

# ============================================================================

#

# Third-party source code should not influence the project's language graph.

#

# Keep this section limited to directories that actually contain vendored

# dependencies. Do not apply it to EDL source directories.

# ============================================================================

/vendor/** linguist-vendored
/third_party/** linguist-vendored
/extern/** linguist-vendored

# ============================================================================

# Generated assets

# ============================================================================

#

# Large generated assets can otherwise distort GitHub's language statistics.

# ============================================================================

*.min.js linguist-generated
*.min.css linguist-generated
*.map linguist-generated

# ============================================================================

# EDL source policy

# ============================================================================

#

# IMPORTANT:

#

# EDL source remains first-class source code regardless of its directory.

#

# Examples:

#

# compiler/frontend.edl       -> EDL

# compiler/parser/parser.edl  -> EDL

# edl/src/edl/lexer.edl       -> EDL

# tests/typecheck.edl         -> EDL

# examples/hello.edl          -> EDL

#

# Do not add broad linguist-vendored or linguist-generated rules for:

#

# /edl/**

# /compiler/**

# /tests/**

# /examples/**

# /tools/**

#

# because these directories may contain first-class EDL source.

#

# ============================================================================

# End of file

# ============================================================================
